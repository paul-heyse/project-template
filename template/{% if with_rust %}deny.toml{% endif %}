# cargo-deny policy: allowed sources and licenses (`just deps`).
# The single-version family rule lives in scripts/check_pins.py, which reads Cargo.lock directly
# so dev-only duplicates count too, and matches crate-name patterns rather than a name list.

[graph]
all-features = false

[advisories]
yanked = "warn"

[bans]
multiple-versions = "allow"
wildcards = "allow"

[sources]
unknown-registry = "deny"
unknown-git = "deny"
# Add each pinned git repository here, with the reason.
allow-git = []

[licenses]
confidence-threshold = 0.9
allow = [
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "MIT",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "Unicode-3.0",
    "Unicode-DFS-2016",
    "Zlib",
    "CC0-1.0",
    "0BSD",
    "ISC",
    "BSL-1.0",
    "MPL-2.0",
    "CDLA-Permissive-2.0",
    "OpenSSL",
    "bzip2-1.0.6",
]

[licenses.private]
ignore = true
