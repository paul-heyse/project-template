strict_env
PATH_rm '*/.venv/bin' '*/.venv-*/bin'
if [[ -n ${VIRTUAL_ENV-} ]]; then
    PATH_rm "$VIRTUAL_ENV/bin"
    unset VIRTUAL_ENV
fi
unset UV_PROJECT_ENVIRONMENT
source_env_if_exists .envrc.local
{% if with_python %}
PATH_add "${UV_PROJECT_ENVIRONMENT:-.venv}/bin"
watch_file pyproject.toml uv.lock
{% endif %}
watch_file .python-version
{% if with_rust %}
watch_file rust-toolchain.toml .cargo/config.toml
{% endif %}
