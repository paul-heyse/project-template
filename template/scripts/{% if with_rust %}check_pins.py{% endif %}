"""Rust dependency policy: deliberate pins have a docs/pins.md row; one version per family.

- Workspace dependencies float by default: a caret requirement (what `cargo add` writes) or an
  open `>=` floor needs nothing. A deliberate pin needs a row in `docs/pins.md` recording its
  reason: an exact `=x.y.z`, a cap (`<`, `<=`, `~` or a wildcard) or a git `rev`/`tag`. A row
  names the crate anywhere in the page, or matches a first-column glob such as `arrow-*`.
- A member of a declared family is pinned exactly (one glob row covers the family), so an
  update cannot move one member without the others.
- `[workspace.metadata.pins] families` lists crate-name patterns whose types cross crate
  boundaries (e.g. `"arrow(-.+)?"`). Two versions of such a crate compile but are incompatible
  at every boundary, so a lockfile holding two fails. Cargo.lock is read directly, so
  dev-dependencies count too.

Usage: check_pins.py [LOCKFILE ...]   (default: ./Cargo.lock)
"""

from __future__ import annotations

import re
import sys
import tomllib
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def families(manifest: Path) -> re.Pattern[str] | None:
    workspace = tomllib.loads(manifest.read_text()).get("workspace", {})
    patterns = workspace.get("metadata", {}).get("pins", {}).get("families", [])
    return re.compile("^(" + "|".join(f"(?:{p})" for p in patterns) + ")$") if patterns else None


def duplicates(lockfile: Path, family: re.Pattern[str] | None) -> dict[str, list[str]]:
    if family is None:
        return {}
    versions: dict[str, set[str]] = defaultdict(set)
    for pkg in tomllib.loads(lockfile.read_text()).get("package", []):
        if family.match(pkg["name"]):
            versions[pkg["name"]].add(pkg["version"])
    return {name: sorted(v) for name, v in versions.items() if len(v) > 1}


def pin_kind(spec: str | dict) -> str | None:
    """`exact pin`, `cap` or `git rev` for a deliberate pin; None for a caret or open floor."""
    if isinstance(spec, dict) and ("rev" in spec or "tag" in spec):
        return "git rev"
    version = spec if isinstance(spec, str) else spec.get("version")
    comparators = [c.strip() for c in (version or "").split(",") if c.strip()]
    if any(c.startswith("=") for c in comparators):
        return "exact pin"
    if any(c.startswith(("<", "~")) or "*" in c for c in comparators):
        return "cap"
    return None


def unpinned(manifest: Path, pins: Path) -> list[str]:
    deps = tomllib.loads(manifest.read_text()).get("workspace", {}).get("dependencies", {})
    family = families(manifest)
    text = pins.read_text()
    globs = [
        cell.strip(" `")[:-1]
        for line in text.splitlines()
        if line.startswith("| ")
        for cell in line.split("|")[1].split(",")
        if cell.strip(" `").endswith("*")
    ]
    problems = []
    for name, spec in sorted(deps.items()):
        kind = pin_kind(spec)
        local = isinstance(spec, dict) and "path" in spec
        if family and family.match(name) and kind not in ("exact pin", "git rev") and not local:
            problems.append(f"{name}: family member not pinned exactly")
            continue
        if kind is None:
            continue
        if name not in text and not any(name.startswith(g) for g in globs):
            problems.append(f"{name}: {kind} without a docs/pins.md row")
    return problems


def main(argv: list[str], root: Path = ROOT) -> int:
    manifest = root / "Cargo.toml"
    failed = False
    for problem in unpinned(manifest, root / "docs" / "pins.md"):
        print(f"Cargo.toml: {problem}")
        failed = True
    family = families(manifest)
    for lock in [Path(a) for a in argv] or [root / "Cargo.lock"]:
        if not lock.exists():
            print(f"{lock}: not_run (no lockfile)")
            continue
        dups = duplicates(lock, family)
        for name, versions in sorted(dups.items()):
            print(f"{lock}: {name} resolves to {', '.join(versions)}")
        failed |= bool(dups)
        if not dups:
            print(f"{lock}: pinned families ok")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
