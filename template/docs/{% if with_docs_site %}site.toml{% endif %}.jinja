# Publication choices only. Architecture/lifecycle remain with their existing owners.
[site]
repository = "https://github.com/{{ github_owner }}/{{ project_name }}"
branch = "main"
base_url = "/"

# Documentation binaries. An empty version means the latest release (presence is checked); a
# version given here is a pin and needs a docs/pins.md row with its reason.
[tools]
mdbook = ""
pagefind = ""
lychee = ""

[publication]
entrypoints = ["README.md", "docs/README.md", "docs/design/README.md", "STATUS.md", "AGENTS.md", "docs/publishing.md"]
# The active plan, once written, e.g. ["docs/plans/<topic>_<YYYY-MM-DD>.md"]
current_work = []
exclude = []
assets = []

[[collections]]
title = "Start here"
include = ["README.md", "STATUS.md", "AGENTS.md"]
scope = "Current"
[[collections]]
title = "Documentation"
include = ["docs/*.md"]
scope = "Reference"
[[collections]]
title = "Architecture"
include = ["docs/design/**/*.md"]
scope = "Current"
[[collections]]
title = "Decisions"
include = ["docs/adr/*.md"]
scope = "Reference"
[[collections]]
title = "Work plans"
include = ["docs/plans/**/*.md"]
scope = "Reference"
[[collections]]
title = "Design standard"
include = ["docs/design_review/design_principles/**/*.md"]
scope = "Current"
[[collections]]
title = "Reviews"
include = ["docs/design_review/reviews/**/*.md"]
scope = "Reference"
[[collections]]
title = "Evidence"
include = ["docs/design_review/evidence/**/README.md"]
scope = "Reference"
[[collections]]
title = "Process"
include = [".claude/skills/README.md", ".claude/skills/adr/*.md", ".claude/skills/design-review/*.md",{% if with_ci_profile %} ".claude/skills/design-review-code-intelligence/*.md",{% endif %} ".claude/skills/handoff/*.md", ".claude/skills/pin-check/*.md", ".claude/agents/*.md"]
scope = "Current"
