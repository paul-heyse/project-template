# End-of-turn pipeline (scripts/after_turn.py). Every step is a just recipe; the checks are the
# dependencies of `just hygiene`. Keys before any [table].

# At stop, synchronously, in order.
sync = ["skills-sync", "adr-index", "fmt"]
# First in the background job; failures always go to the operator.
ready = ["doctor-check"]
# Failures the fixer never gets.
operator_only = ["skills-sync", "adr-index"{% if with_rust %}, "deps"{% endif %}]
# After the job, one run per burst of stops; nothing waits on them.
after = []
# Outputs of `after`: excluded from the tree fingerprint, and the fixer never edits them.
after_outputs = []
# Further paths the fixer never edits.
protected = []
# Seconds before a hung step is killed.
check_timeout = 1200

# Run a sync step only when these glob pathspecs differ from HEAD or are untracked, e.g.
# [sync_when]
# build-features = ["Cargo.lock", "**/Cargo.toml"]
