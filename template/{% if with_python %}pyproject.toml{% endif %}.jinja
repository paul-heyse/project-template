{%- set pyminor = python_version.split('.')[:2] | join('.') -%}
[project]
name = "{{ project_name }}-dev"
version = "0.0.0"
description = "The uv root: repo scripts, their tests and the dev tools. Product Python packages join as workspace members."
requires-python = ">={{ pyminor }}"
dependencies = []

# Add product packages as members (e.g. members = ["python/*"]) and list them in `dependencies`
# with `[tool.uv.sources] <name> = { workspace = true }`, so the root environment tests them.
[tool.uv.workspace]
members = []

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff==0.16.7",
    "pyrefly==1.3.1",
    "hypothesis==6.168.1",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--strict-markers", "--strict-config", "-q"]
pythonpath = ["scripts"]

[tool.ruff]
line-length = 100
src = ["scripts"]
target-version = "py{{ pyminor | replace('.', '') }}"
# Fixtures are analyzer input; docs may contain illustrative code fences. A subdirectory that is a
# separate Python project with its own environment (conventionally under `services/`) is excluded.
extend-exclude = ["fixtures", ".claude/skills", "target", "docs", "services"]
force-exclude = true

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF"]

[tool.pyrefly]
python-version = "{{ pyminor }}"
project-includes = ["scripts", "tests"]
project-excludes = ["fixtures/**", ".claude/**", "**/target/**"]
search-path = ["scripts"]
site-package-path = [".venv/lib/python{{ pyminor }}/site-packages"]
